[HWPortInstall]
CopyFiles = CopyFileSection00
AddReg = All00, AddReg

;HWPCUI
[HWPortInstall02]
CopyFiles = CopyFileSection00
AddReg = All02, AddReg.NT

;HWDIAG
[HWPortInstall03]
CopyFiles = CopyFileSection00
AddReg = All03, AddReg.NT

;HWDBAPTER
[HWPortInstall04]
CopyFiles = CopyFileSection00
AddReg = All04, AddReg.NT

;HWDBCONSOLE
[HWPortInstall05]
CopyFiles = CopyFileSection00
AddReg = All05, AddReg.NT

;HWGPS
[HWPortInstall08]
CopyFiles = CopyFileSection00
AddReg = All08, AddReg.NT

;HWRMNET
[HWPortInstall09]
CopyFiles = CopyFileSection00
AddReg = All09, AddReg.NT

;HWNMEA
[HWPortInstall0A]
CopyFiles = CopyFileSection00
AddReg = All0A, AddReg.NT

[HWPortInstall.Services]
