AddReg = All02, AddReg

[HWPortInstallFWT02.Services]
AddService = HWHandSetProLine,  0x00000002, HW_USBSerialServiceFWT0

[HW_USBSerialServiceFWT0]
DisplayName   = %SERVICE%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hw_quusbmdm.sys
;AddReg        = PowerReg

