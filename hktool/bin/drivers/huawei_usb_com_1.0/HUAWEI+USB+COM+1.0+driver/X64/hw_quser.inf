; ===================== Installation Section Begin =============================
; ===================== Installation FP Section ================================
[HWPortInstallFP02]
CopyFiles = CopyFileSection00
AddReg = All02, AddReg

[HWPortInstallFP02.Services]
AddService = HWHandSetProLine,  0x00000002, HW_USBSerialServiceFP

[HWPortInstallFP0A]
CopyFiles = CopyFileSection00
AddReg = All0A, AddReg

[HWPortInstallFP0A.Services]
AddService = HWHandSetProLine,  0x00000002, HW_USBSerialServiceFP

[HW_USBSerialServiceFP]
DisplayName   = %SERVICE%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hw_quusbmdm.sys
;AddReg        = PowerReg

; =================== Installation FWT0(FC612E) Section ========================
[HWPortInstallFWT0]
CopyFiles = CopyFileSection00
AddReg = All00, AddReg

[HWPortInstallFWT0.Services]
